# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration for future Vercel Functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Required on hosted deployments for encrypted, per-account provider cookies.
AI_CONNECTION_SECRET=

# Free local inference. Vercel defaults to public source search when no model is configured.
# Never prefix provider secrets with VITE_.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional bearer token for a secured remote Ollama-compatible endpoint (server only).
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
AI_VECTOR_STORE=local
AI_DATA_DIR=.data/ai-pgvector
# Time budget for one AI request. Local app: default 300000, maximum 600000 (CPU-only models are slow).
# Hosted (Vercel) deployments are always capped at 110000 to fit the 120 s function limit.
AI_TIMEOUT_MS=300000

# Optional local workspace generation (hosted accounts use individual keys in Settings).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hosted semantic search requires OLLAMA_BASE_URL pointing to a reachable embedding server.
# Do not copy localhost or AI_VECTOR_STORE=local into Vercel environment variables.

# Optional local workspace keys. Never use these as shared hosted account keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HF_TOKEN=
HF_MODEL=

# In-process embeddings and reranking (free, no key). Models live in AI_MODEL_DIR
# (npm run models:fetch). Set AI_MODEL_DOWNLOAD=false to forbid runtime downloads.
AI_MODEL_DIR=models
AI_MODEL_DOWNLOAD=true
# WebAssembly threads for ONNX Runtime; default is half the CPU cores (max 4) locally, 1 on Vercel.
AI_ONNX_THREADS=
# Do not copy localhost or AI_VECTOR_STORE=local into Vercel environment variables.
