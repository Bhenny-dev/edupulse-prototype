# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration for future Vercel Functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Free local inference. Vercel defaults to public source search when no model is configured.
# Never prefix provider secrets with VITE_.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional bearer token for a secured remote Ollama-compatible endpoint (server only).
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
AI_VECTOR_STORE=local
AI_DATA_DIR=.data/ai-pgvector
AI_TIMEOUT_MS=110000

# Optional hosted generation (account quotas and pricing apply).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hosted semantic search requires OLLAMA_BASE_URL pointing to a reachable embedding server.
# Do not copy localhost or AI_VECTOR_STORE=local into Vercel environment variables.
